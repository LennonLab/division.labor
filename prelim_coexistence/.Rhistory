temporal.stability <- combined %>%
group_by(Culture, Replicate) %>%
summarise(
Mean = mean(OD),
SD = sd(OD),
Stability = Mean / SD,
Temporal.Variability = SD / Mean,
.groups = "drop")
#temporal.stability <- temporal.stability [-c(10:15),] #removal of the two statisticall dissimilar Arg+trp and His+Iso
temporal.stability.aov <- aov(Stability ~Culture, temporal.stability )
summary(temporal.stability.aov)
TukeyHSD(temporal.stability.aov)
#temporal.stability%>%gt()
temp.table<-temporal.stability %>%
flextable() %>%
colformat_double(digits = 3) %>%
set_header_labels(
Mean = "Mean OD",
Stability = "Stability (Mean/SD)",
Temporal.Variability = "Temporal Variability",
Replicate = "Replicate"
) %>%
autofit()
ggplot(temporal.stability, aes(x=Culture, y=Stability, group = Culture)) +geom_boxplot()+ geom_point()+ labs(y= "Stability", color = "Type")+ theme(axis.text.x = element_text(angle = 65, vjust = 1, hjust = 1))
