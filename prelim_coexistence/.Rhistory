long <- function(data, culture) {
data |>
pivot_longer(
cols = everything(),
names_to = "Day",
values_to = "OD"
) |>
dplyr::mutate(Culture = culture)
}
A3Tr3 <- long(A3Tr3, "Arg+Trp")
AsTr3 <- long(AsTr3, "Arg(NS)+Trp")
A3Trs <- long(A3Trs, "Arg+Trp(NS)")
AsTrs <- long(AsTrs, "Arg(NS)+Trp(NS)")
P3Ty3 <-  long(P3Ty3, "Phe+Tyr")
PsTy3 <-  long(PsTy3, "Phe(NS)+Tyr")
P3Tys <-  long(P3Tys, "Phe+Tyr(NS)")
PsTys <-  long(PsTys, "Phe(NS)+Tyr(NS)")
combined<- rbind(A3Tr3,AsTr3,A3Trs,AsTrs,P3Ty3,PsTy3,P3Tys,PsTys)
combined$Day <- factor(combined$Day,
levels = c("3", "9", "12", "18","21")
combined <- combined %>%
levels = c("3", "9", "12", "18","21")
combined <- combined %>%
group_by(Culture) %>%
mutate(Replicate = rep(1:3, each = n() / 3)) %>%
ungroup()
ggplot(combined, aes(x = Day, y = OD, group = Culture)) +geom_point()+
geom_smooth() +
facet_wrap(~ Culture, ncol = 5) +
labs(x = "Day", y = "OD600", color = "Culture") +
scale_y_continuous(breaks = seq(0, 2, by = 0.5)) +
theme_minimal(base_size = 12) +
theme(
axis.text.x = element_text(angle = 68, vjust = 1, hjust = 1),
strip.text = element_text(face = "bold"),
legend.position = "bottom"
)
