data <- read.csv("20261012_1127_coculture_des_ArgTrp.csv")
#surv <- read.table("./data/Biofilm_Survivorship.txt",header=TRUE,sep="\t")
data.surv<-Surv(data$Time, data$Event)
datasurv.fit <- survfit(data.surv ~ data$Strain, conf.int = TRUE,
type = "kaplan-meier")
biofsurv.diff <- survdiff(Surv(data$Time,data$Event) ~ data$Replicate, data = data)
data$Replicate <- c(rep(1:4))
data$Replicate
data
